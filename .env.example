# ─────────────────────────────────────────────────────────────────────────────
# NEVEN TECH — Environment Configuration
# Copy this file to .env and customize for your deployment
# ─────────────────────────────────────────────────────────────────────────────

# ─── API Keys ────────────────────────────────────────────────────────────────
NEVEN_API_KEY=nv_dev_your_api_key_here
NEVEN_AGENT_PRIVATE_KEY=your_agent_private_key_here

# ─── Server ──────────────────────────────────────────────────────────────────
NEVEN_HOST=0.0.0.0
NEVEN_PORT=8420
NEVEN_WORKERS=4
NEVEN_DEBUG=false

# ─── Perception ──────────────────────────────────────────────────────────────
NEVEN_DETECTION_MODEL=builtin        # Options: builtin, yolov8n, yolov8s, yolov8m
NEVEN_DETECTION_CONFIDENCE=0.35
NEVEN_FRAME_RATE=15
NEVEN_TRACKING_MAX_AGE=30

# ─── Safety Engine ───────────────────────────────────────────────────────────
NEVEN_SAFETY_ENABLED=true
NEVEN_MAX_ACTUATION_FREQ=10.0

# ─── Storage ─────────────────────────────────────────────────────────────────
NEVEN_REDIS_URL=redis://localhost:6379
NEVEN_DATABASE_URL=sqlite:///neven.db

# ─── Analytics ───────────────────────────────────────────────────────────────
NEVEN_ANALYTICS_ENABLED=true
NEVEN_HEATMAP_RESOLUTION=50
NEVEN_DWELL_THRESHOLD=5.0

# ─── Logging ─────────────────────────────────────────────────────────────────
NEVEN_LOG_LEVEL=INFO
NEVEN_LOG_FILE=
